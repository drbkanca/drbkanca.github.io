---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJournalData } from '../../data.js';
const data = getJournalData();
const stats = data.stats || {};
const articles = (data.articles || []).slice(0, 6);
const infoPageOrder = ['about','aim-and-scope','publication-fees','editorial-board','publication-ethics','correction-retraction-policy','statistics','writing-rules','indexing','publication-process','open-access-policy','reviewer-guidelines','editorial-policies','editor-guidelines','editorial-office','contact','archive','archive-policy'];
const pageOrder = Object.fromEntries(infoPageOrder.map((slug, index) => [slug, index]));
const pages = (data.pages || []).sort((a, b) => (pageOrder[a.slug] ?? 999) - (pageOrder[b.slug] ?? 999));
const knownPolicyPages = [{slug:'archive-policy',titleTr:'Arşiv Politikası',url:'https://dergipark.org.tr/tr/pub/journalata/page/22243'},{slug:'correction-retraction-policy',titleTr:'Düzeltme ve Geri Çekme Politikası',url:'https://dergipark.org.tr/tr/pub/journalata/page/22247'}];
const knownPolicySlugs = new Set(knownPolicyPages.map(p=>p.slug));
const infoPages = [{slug:'about',titleTr:'Hakkında',url:'https://dergipark.org.tr/tr/pub/journalata/about-journal'}, ...pages, ...knownPolicyPages.filter(p=>!pages.some(synced=>synced.slug===p.slug))].sort((a,b)=>(pageOrder[a.slug]??999)-(pageOrder[b.slug]??999));
const updated = data.updatedAt ? new Date(data.updatedAt).toLocaleString('tr-TR') : 'Henüz güncellenmedi';
const announcements = (data.announcements || []).slice(0, 3);
const pageTitleTr = (p) => p.slug === 'statistics' ? 'Dergi İstatistikleri' : p.titleTr || ({'Aim & Scope':'Amaç ve Kapsam','Aims & Scope':'Amaç ve Kapsam','Price Policy':'Ücret Politikası','Journal Boards':'Dergi Kurulları','Statistics':'Dergi İstatistikleri','Journal Statistics':'Dergi İstatistikleri','Acceptance-Rejection Statistics':'Dergi İstatistikleri','Author Guidelines':'Yazım Kuralları','Writing Rules':'Yazım Kuralları','Ethical Principles and Publication Policy':'Etik İlkeler ve Yayın Politikası','Indexes':'Dizinler','Indexing':'Dizinler','Publication Process':'Yayın Süreci','Open Access Policy':'Açık Erişim Politikası','Editorial Policies':'Editoryal Politikalar','Editor Guidelines':'Editör Rehberi','Reviewer Guidelines':'Hakem Rehberi','Editorial Office':'Editoryal Ofis','Archive':'Arşiv','Archive Policy':'Arşiv Politikası','Archiving Policy':'Arşiv Politikası','Correction and Retraction Policy':'Düzeltme ve Geri Çekme Politikası','Corrections and Retractions Policy':'Düzeltme ve Geri Çekme Politikası','Correction & Retraction Policy':'Düzeltme ve Geri Çekme Politikası','Journal Contacts':'Dergi İletişim'}[p.title] || p.title);
const articleUrl = (a) => (a.url || 'https://dergipark.org.tr/tr/pub/journalata').replace('/en/pub/', '/tr/pub/');const announcementHome = 'https://dergipark.org.tr/tr/journalata/announcements/2772';
const announcementFallback = 'Dergi, 2027 itibarıyla yayın dilini yalnızca İngilizce olarak sürdürecek. Duyuru, yeni yayın dili uygulamasını ve makale gönderimlerine ilişkin güncellemeyi açıklıyor.';
---
<BaseLayout title="Ana Sayfa" description="Journal of Academic Tourism Analysis — Elmas Açık Erişim modelinde, uluslararası ve çift kör hakemli dergi" lang="tr">
<section class="hero"><div class="wrap hero-layout"><div class="hero-content">
  <div class="hero-tags" aria-label="Dergi özellikleri"><span>Uluslararası</span><span>Elmas Açık Erişim</span><span>Çift kör hakemlik</span></div>
  <h1>Journal of Academic Tourism Analysis</h1><div class="hero-translation">Akademik Turizm Analizi Dergisi</div>
  <p>Turizmi şekillendiren özgün araştırmaları, uluslararası akademik tartışmanın merkezine taşıyoruz.</p>
  <div class="hero-actions"><a class="button" href="https://dergipark.org.tr/tr/journal/4326/submission/step/manuscript/new">Makale Gönder ↗</a><a class="button button-secondary" href="https://dergipark.org.tr/tr/journal/4326/reviewer-request/send">Hakem Ol ↗</a><button class="button button-secondary share-button" type="button" data-share-page data-copy-message="Bağlantı kopyalandı." data-copy-error="Paylaşım şu anda kullanılamıyor.">Sayfayı Paylaş</button><span class="share-status" data-share-status aria-live="polite"></span></div>
</div><figure class="hero-cover"><img src="/journal-cover.jpg" alt="Akademik Turizm Analizi Dergisi kapak görseli" loading="eager" fetchpriority="high" /></figure></div></section>
<script>
  const shareButton = document.querySelector("[data-share-page]");
  const shareStatus = document.querySelector("[data-share-status]");
  shareButton?.addEventListener("click", async () => {
    const shareData = { title: document.title, text: document.querySelector('meta[name="description"]')?.content || document.title, url: location.href };
    if (navigator.share) {
      try { await navigator.share(shareData); return; }
      catch (error) { if (error?.name === "AbortError") return; }
    }
    try { await navigator.clipboard.writeText(location.href); shareStatus.textContent = shareButton.dataset.copyMessage; }
    catch { shareStatus.textContent = shareButton.dataset.copyError; }
  });
</script>
<div class="wrap meta-strip"><div class="meta"><b>2020</b><span>Kuruluş yılı</span></div><div class="meta"><b>2024</b><span>Yeni adıyla yayın</span></div><div class="meta"><b>3023-8986</b><span>e-ISSN</span></div><div class="meta"><b>Sürekli yayın</b><span>Yayın sıklığı</span></div><div class="meta"><b>Ücretsiz yayın</b><span>Yazar ücreti yok</span></div><div class="meta publisher-meta"><b><a href="https://dergipark.org.tr/tr/pub/publisher/2051" target="_blank" rel="noreferrer">Bayram KANCA ↗</a></b><span>Yayımcı</span></div></div>
<section class="metrics-section"><div class="wrap"><div class="metrics-heading">DergiPark yayın süreci istatistikleri</div><div class="metrics-grid"><div><b>{stats.firstDecision ?? 7} gün</b><span>Ön kontrol</span></div><div><b>{stats.finalDecision ?? 68} gün</b><span>Son karara kadar</span></div><div><b>{stats.publication ?? 25} gün</b><span>Yayımlanma</span></div></div></div></section>
<div class="about-announcement-order"><section class="section about-section" id="about"><div class="wrap two-col"><div class="panel about-panel"><div class="eyebrow">Dergi hakkında</div><h2>Araştırma odağımız</h2><p>Akademik Turizm Analizi Dergisi (Journal ATA), turizm ve ilgili disiplinlerde kuramsal temellere dayanan, metodolojik açıdan titiz ve toplumsal karşılığı olan özgün araştırmaları yayımlamayı amaçlayan uluslararası, çift kör hakemli bir platformdur. Turizm olgularını yalnızca betimlemenin ötesine geçerek yeni kuramsal perspektifler geliştiren, mevcut çerçeveleri eleştirel biçimde değerlendiren ve sektörel uygulamalara kanıta dayalı çözümler sunan çalışmaları teşvik eder.</p><p>Dergi; turizm ve konaklama işletmeciliğinden gastronomiye, rekreasyondan destinasyon yönetimine, sürdürülebilir ve akıllı turizmden turizm sosyolojisi, ekonomisi ve politikalarına kadar geniş bir disiplinlerarası yelpazede akademik katkıları kabul etmektedir. Bilimsel mükemmellik, editoryal şeffaflık ve araştırma bütünlüğünden ödün vermeyen Journal ATA, Avrasya Turizm Araştırmaları Dergisi adıyla başlayan yolculuğunu 5. yayın yılında uluslararasılaşma vizyonuyla taçlandırmıştır.</p><p>Yazarlardan ve okuyuculardan hiçbir ücret talep etmeyen Elmas Açık Erişim (Diamond Open Access) modeliyle yayın yapan dergi, 2026 yılı itibarıyla Sürekli Yayın modeline geçmiştir. Bu yenilikçi yaklaşım sayesinde kabul edilen makaleler, sayı süreçlerini beklemeksizin tamamlandığı anda küresel literatürdeki yerini alır. Journal ATA; araştırmacılara, akademisyenlere ve politika yapıcılara küresel ölçekte güçlü, şeffaf ve kesintisiz bir akademik iletişim ağı sunmaktadır.</p></div><div class="panel information-panel"><div class="eyebrow">Dergi Bilgileri</div><div class="quicklinks">{infoPages.map(p=><a href={p.url || (p.sourceUrl || '').replace('/en/pub/','/tr/pub/')}>{p.titleTr || pageTitleTr(p)}</a>)}</div></div></div></section>
<section class="section announcement-section" id="announcements"><div class="wrap"><div class="section-head"><h2>Duyurular</h2><a class="button" href={announcementHome} target="_blank" rel="noreferrer">DergiPark’ta Gör ↗</a></div>{announcements.length ? <div class="announcements-list">{announcements.map(item=><a class="announcement-item" href={announcementHome} target="_blank" rel="noreferrer"><div><h3>{item.titleTr || item.title}</h3><p>{(item.descriptionTr || item.description || announcementFallback).slice(0,240)}{(item.descriptionTr || item.description || announcementFallback).length>240?'…':''}</p></div>{(item.dateTr || item.date) && <time>{item.dateTr || item.date}</time>}</a>)}</div> : <div class="announcements-list"><a class="announcement-item" href={announcementHome} target="_blank" rel="noreferrer"><div><h3>Journal ATA 2027 Yılı Yayın Dili Güncellemesi ve Makale Gönderimleri</h3><p>{announcementFallback}</p></div><time>9 Kasım 2026</time></a></div>}</div></section>
<section class="section latest-section" id="latest"><div class="wrap"><div class="section-head"><h2>Son Makaleler</h2><a class="button" href="/tr/page/archive">Arşivi Gör ↗</a></div>
{articles.length ? <div class="grid">{articles.map(a=>{const title=a.titleTr||a.title;const abstract=a.abstractTr||a.abstract;return <article class="article"><span class="tag">Araştırma makalesi</span><h3>{title || 'Başlıksız makale'}</h3><p>{(abstract || '').slice(0,210)}{(abstract || '').length>210?'…':''}</p><div class="byline">{a.authors || 'Yazar bilgisi'}{a.date ? ' · ' + a.date : ''}</div><a class="read" href={articleUrl(a)} target="_blank" rel="noreferrer">DergiPark makalesini aç ↗</a></article>})}</div> : <div class="empty">Son makaleler şu anda görüntülenemiyor.</div>}
</div></section>
<div slot="footer-note" class="sync-note">Son içerik güncellemesi: {updated}</div>
</BaseLayout>
